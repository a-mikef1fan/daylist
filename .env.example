# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# PostgreSQL connection string (required)
DATABASE_URL=

# Secret for Better Auth (required outside local development)
BETTER_AUTH_SECRET=

# Enables "Describe a theme": the server calls the Claude API to design a theme from plain text.
# Server-side only; never exposed to the browser. Without it the feature shows a friendly "not set up" message.
ANTHROPIC_API_KEY=

# Optional: override the model used for theme generation (defaults to claude-opus-5-5).
# ANTHROPIC_THEME_MODEL=
